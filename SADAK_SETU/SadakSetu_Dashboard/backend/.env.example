APP_NAME=SadakSetu API
APP_ENV=development
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# PostgreSQL 17 with the PostGIS extension is required for the database phase.
DATABASE_URL=postgresql+psycopg://sadaksetu:change-me@localhost:5432/sadaksetu
SESSION_COOKIE_NAME=sadaksetu_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_MINUTES=480
ANDROID_SESSION_TTL_DAYS=30
SESSION_IDLE_TIMEOUT_MINUTES=60
PASSWORD_MIN_LENGTH=12
UPLOAD_ROOT=uploads
MAX_IMAGE_SIZE_BYTES=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
AI_MODEL_PATH=models/baseline_yolo11.pt
AI_MODEL_NAME=baseline-yolo11-pothole
AI_MODEL_VERSION=1.0
AI_ANNOTATED_ROOT=uploads/annotated
SEVERITY_SMALL_AREA_RATIO=0.05
SEVERITY_MEDIUM_AREA_RATIO=0.15
SEVERITY_LARGE_AREA_RATIO=0.35
SEVERITY_MEDIUM_COUNT=2
SEVERITY_HIGH_COUNT=3
SEVERITY_CRITICAL_COUNT=5
FCM_ENABLED=false
# FCM_CREDENTIALS_PATH=/secure/path/firebase-service-account.json
