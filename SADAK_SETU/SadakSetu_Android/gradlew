#!/bin/sh

set -e

APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar:$APP_HOME/gradle/wrapper/gradle-wrapper-shared-9.1.0.jar:$APP_HOME/gradle/wrapper/gradle-cli-9.1.0.jar:$APP_HOME/gradle/wrapper/gradle-files-9.1.0.jar:$APP_HOME/gradle/wrapper/gradle-stdlib-java-extensions-9.1.0.jar:$APP_HOME/gradle/wrapper/gradle-client-services-9.1.0.jar:$APP_HOME/gradle/wrapper/failureaccess-1.0.3.jar"

if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    JAVA_CMD="$JAVA_HOME/bin/java"
else
    JAVA_CMD="java"
fi

exec "$JAVA_CMD" -Xmx64m -Xms64m -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
